TS_AUTHKEY=TOKEN

# --- Netdata targets -------------------------------------------------------
# Every *_NETDATA_IP variable becomes a scrape target automatically; the part
# before _NETDATA_IP becomes the "node" label. Add one line per server - all
# rules and dashboards are per-node, so no other file needs to change.
# Use "host-gateway" for the Docker host itself.
R7525_01_NETDATA_IP=YOUR_IP_HERE
RX2540M4_01_NETDATA_IP=YOUR_IP_HERE

PROMETHEUS_UID=1000
PROMETHEUS_GID=1000
GRAFANA_UID=472
GRAFANA_GID=472
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

GRAFANA_SERVER_PROTOCOL=http
GRAFANA_SERVER_DOMAIN=localhost
GRAFANA_SERVER_ROOT_URL=https://localhost/

# Space-separated "host:port|label". Coder must be started with
# CODER_PROMETHEUS_ENABLE=true and CODER_PROMETHEUS_ADDRESS bound to an address
# this host can reach (0.0.0.0:2112, with the port published) - the default
# 127.0.0.1 is the Coder container's own loopback and is not reachable.
CODER_PROMETHEUS_TARGETS=

# Alloy from the syslog-docker project. Leave empty if that stack is not
# deployed; the job then has no targets rather than a permanently red one.
SYSLOG_ALLOY_TARGETS=syslog-alloy:12345|syslog

# --- FortiGate (SNMP) ------------------------------------------------------
# Space-separated list of "host|label". The label becomes the "device" label on
# every FortiGate metric. Poll goes through the snmp-exporter service.
#   FORTIGATE_SNMP_TARGETS=YOUR_FORTIGATE_IP|fortigate-201f
FORTIGATE_SNMP_TARGETS=
# SNMPv2c community configured on the FortiGate (see README.md).
FORTIGATE_SNMP_COMMUNITY=change-me

# --- Printers (Printer-MIB) -------------------------------------------------
# Space-separated "host|label". Vendor-neutral: anything answering RFC 3805.
PRINTER_SNMP_TARGETS=
# Many printers ship with "public" and no host restriction. It is read-only,
# but it still exposes device details to the whole LAN - change it on the
# device and here if that matters.
PRINTER_SNMP_COMMUNITY=public

# --- Aruba Instant APs (SNMPv3) ---------------------------------------------
# An Instant AP has no per-host SNMP restriction, so the credential is the only
# access control - v3 authPriv rather than a community in the clear.
#   snmp-server user <name> sha256 <auth> aes <priv>   (then: commit apply)
ARUBA_SNMP_TARGETS=
ARUBA_SNMP_USERNAME=prometheus
ARUBA_SNMP_AUTH_PASSWORD=change-me
ARUBA_SNMP_PRIV_PASSWORD=change-me

# --- Loki ------------------------------------------------------------------
# Receives FortiGate syslog from the syslog-docker stack. Must be able to write
# ./data/loki, so match this to that directory's owner.
LOKI_UID=1000
LOKI_GID=1000
# Long-term window. Local text files only buffer a couple of weeks; this is
# what actually holds history.
LOKI_RETENTION_PERIOD=90d
