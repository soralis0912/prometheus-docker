TS_AUTHKEY=TOKEN

# --- Netdata targets -------------------------------------------------------
# Every *_NETDATA_IP variable becomes a scrape target automatically; the part
# before _NETDATA_IP becomes the "node" label. Add one line per server - all
# rules and dashboards are per-node, so no other file needs to change.
# Use "host-gateway" for the Docker host itself.
R7525_01_NETDATA_IP=YOUR_IP_HERE
RX2540M4_01_NETDATA_IP=YOUR_IP_HERE

PROMETHEUS_UID=1000
PROMETHEUS_GID=1000
GRAFANA_UID=472
GRAFANA_GID=472
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

GRAFANA_SERVER_PROTOCOL=http
GRAFANA_SERVER_DOMAIN=localhost
GRAFANA_SERVER_ROOT_URL=https://localhost/

CODER_PROMETHEUS_TARGETS=

# --- FortiGate (SNMP) ------------------------------------------------------
# Space-separated list of "host|label". The label becomes the "device" label on
# every FortiGate metric. Poll goes through the snmp-exporter service.
#   FORTIGATE_SNMP_TARGETS=YOUR_FORTIGATE_IP|fortigate-201f
FORTIGATE_SNMP_TARGETS=
# SNMPv2c community configured on the FortiGate (see README.md).
FORTIGATE_SNMP_COMMUNITY=change-me

# --- Loki ------------------------------------------------------------------
# Receives FortiGate syslog from the syslog-docker stack. Must be able to write
# ./data/loki, so match this to that directory's owner.
LOKI_UID=1000
LOKI_GID=1000
# Long-term window. Local text files only buffer a couple of weeks; this is
# what actually holds history.
LOKI_RETENTION_PERIOD=90d
